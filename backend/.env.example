# ==============================================================================
# recet-system / backend - Plantilla de variables de entorno
# ==============================================================================
# Copie este archivo a `.env` y coloque valores REALES.
# El backend valida este contrato al arrancar (src/config/env.validation.ts):
# si falta una variable, tiene formato invalido o conserva un texto de ejemplo
# (REEMPLAZAR..., dummy, change_me, <...>), el proceso NO inicia.
# No existe ningun valor por defecto en el codigo.
# ==============================================================================

# --- Entorno de ejecucion -----------------------------------------------------
# development | production | test
NODE_ENV=development

# Puerto HTTP del API NestJS (1-65535)
PORT=4000

# --- Base de datos PostgreSQL -------------------------------------------------
# Cadena de conexion completa. Debe iniciar con postgresql:// o postgres://
# Ejemplo local:  postgresql://postgres:mipassword@localhost:5432/recet_system
# Ejemplo Neon:   postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/recet_system
DATABASE_URL=REEMPLAZAR_CON_LA_CADENA_DE_CONEXION_POSTGRES

# TLS hacia la base de datos. Exactamente "true" o "false".
# Proveedores gestionados (Neon, Supabase, Render, RDS) => true
# PostgreSQL local sin certificados                     => false
DATABASE_SSL=true

# --- Autenticacion JWT --------------------------------------------------------
# Minimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_48_BYTES

# Vigencia del token. Formato <numero><s|m|h|d>. Ej: 7d, 12h, 3600s
JWT_EXPIRES_IN=7d

# --- Frontend -----------------------------------------------------------------
# Origen exacto del cliente Next.js. Se usa para CORS y para el redirect
# posterior al login con Google. Sin barra final.
FRONTEND_URL=http://localhost:3000

# --- Google OAuth 2.0 ---------------------------------------------------------
# Credenciales de https://console.cloud.google.com/apis/credentials
# El callback debe estar registrado tal cual en "URIs de redireccionamiento
# autorizados" de la aplicacion OAuth.
GOOGLE_CLIENT_ID=REEMPLAZAR_CON_EL_CLIENT_ID_DE_GOOGLE
GOOGLE_CLIENT_SECRET=REEMPLAZAR_CON_EL_CLIENT_SECRET_DE_GOOGLE
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
