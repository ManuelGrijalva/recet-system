# ==============================================================================
# recet-system / frontend - Plantilla de variables de entorno
# ==============================================================================
# Copie este archivo a `.env.local` (ignorado por git) y ajuste los valores.
# En Next.js solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# ==============================================================================

# URL base del API NestJS, incluyendo el prefijo global /api.
# Desarrollo local (backend en el puerto PORT=4000):
NEXT_PUBLIC_API_URL=http://localhost:4000/api
