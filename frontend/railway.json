{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter frontend build",
    "watchPatterns": ["frontend/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter frontend start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
